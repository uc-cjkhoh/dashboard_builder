@* Start screen: shown over the Data Source view while no server is connected. Lists recent workbooks
   (browser-held metadata only: server, user, last saved, counts — never data or a password); picking one
   refills the connection form. Driven by Start/start.js; rules in Start/start-model.js. *@
<section class="start" id="start-screen" aria-labelledby="start-title" hidden>
    <div class="start__inner">
        <h2 class="start__title" id="start-title">Start</h2>
        <button type="button" class="btn btn--primary" id="start-connect">Connect to a server</button>
        <section id="start-recent-block" aria-labelledby="start-recent-title" hidden>
            <h3 class="start__heading" id="start-recent-title">Recent workbooks</h3>
            <ul class="start__list" id="start-recent"></ul>
        </section>
    </div>
</section>

@* Connection panel (sidebar top). Wired end-to-end in Connection/connection.js. Port/secure
   default to the TLS pair (8443, decision D10). *@
<section class="sidebar__section" aria-labelledby="conn-title">
    <div class="sidebar__title-row">
        <h2 class="sidebar__title" id="conn-title">Connection</h2>
    </div>

    <!-- Compact connected summary — replaces the form once connected. -->
    <div class="conn-summary" id="conn-summary" hidden>
        <span class="conn-summary__dot" aria-hidden="true"></span>
        <span class="conn-summary__host" id="conn-host-label"></span>
        <span class="conn-summary__warn" id="conn-warn" hidden data-icon="warning" role="img"
              aria-label="Certificate not verified" title="Certificate not verified"></span>
        <button type="button" class="iconbtn conn-summary__btn" id="conn-change"
                aria-label="Change connection" title="Change connection" aria-controls="conn-form" aria-expanded="false"><span data-icon="edit"></span></button>
        <button type="button" class="iconbtn iconbtn--danger conn-summary__btn" id="conn-disconnect"
                aria-label="Disconnect" title="Disconnect"><span data-icon="power"></span></button>
    </div>

    <!-- Recent sources (host, port, user only — never a password). Shown with the form. -->
    <ul class="conn-recent" id="conn-recent" aria-label="Recent connections" hidden></ul>

    <form class="conn-form" id="conn-form" autocomplete="off">
        <div class="form-field">
            <label for="conn-host">Host</label>
            <input type="text" id="conn-host" name="host" maxlength="253" placeholder="clickhouse.example.com" />
        </div>
        <div class="form-row">
            <div class="form-field">
                <label for="conn-port">Port</label>
                <input type="text" inputmode="numeric" maxlength="5" id="conn-port" name="port" value="8443" />
            </div>
            <div class="form-field">
                <label for="conn-user">User</label>
                <input type="text" id="conn-user" name="user" maxlength="64" value="default" />
            </div>
        </div>
        <div class="form-field">
            <label for="conn-password">Password</label>
            <input type="password" id="conn-password" name="password" maxlength="256" />
        </div>
        <details class="conn-advanced" id="conn-advanced">
            <summary>Advanced</summary>
            <label class="form-check">
                <input type="checkbox" id="conn-secure" name="secure" checked />
                Secure (TLS)
            </label>
            <!-- Certificate validation is on by default (P8/D10). This opt-in trusts an
                 invalid/self-signed cert — only shown under TLS, and it warns when checked. -->
            <label class="form-check form-check--sub" id="conn-allowcert-row">
                <input type="checkbox" id="conn-allowcert" name="allowInvalidCert" />
                Trust invalid / self-signed certificate
            </label>
            <p class="form-warn" id="conn-allowcert-warn" hidden>
                Certificate validation is off — only for a server whose cert you trust.
            </p>
        </details>
        <div class="conn-form__actions">
            <button type="submit" class="btn btn--primary" id="conn-connect">Connect</button>
            <button type="button" class="btn" id="conn-cancel" hidden>Cancel</button>
        </div>
    </form>
</section>

@* Connection panel (sidebar top). Wired end-to-end in Connection/connection.js. Port/secure
   default to the TLS pair (8443, decision D10); Secure and Trust are visible switches (D98). *@
<h2 class="sidebar__title" id="conn-title">Connections</h2>
<section class="sidebar__section sidebar__section--conn" aria-labelledby="conn-title">

    <!-- Connected: one row. Its dot is the only coloured thing here and shows the last liveness probe (ok / checking / lost),
         never the moment of connecting. The two things you can do with a connection sit on the row, right-aligned. -->
    <div class="conn-summary" id="conn-summary" data-health="ok" hidden>
        <div class="conn-row">
            <span class="conn-status" id="conn-status" aria-hidden="true"></span>
            <span class="conn-row__text">
                <span class="conn-summary__host" id="conn-host-label"></span>
                <span class="conn-summary__meta" id="conn-detail-label"></span>
            </span>
            <div class="conn-row__actions">
                <button type="button" class="iconbtn conn-row__btn" id="conn-change" aria-controls="conn-form"
                        aria-label="Change connection" title="Change connection"><span data-icon="edit"></span></button>
                <button type="button" class="iconbtn conn-row__btn" id="conn-disconnect"
                        aria-label="Disconnect" title="Disconnect"><span data-icon="power"></span></button>
            </div>
        </div>
        <span class="sr-only" id="conn-health-text" role="status">Connected</span>
    </div>

    <!-- Shown only when probes fail: what happened, and the one way out. -->
    <div class="conn-lost" id="conn-lost" hidden>
        <span class="conn-lost__text">Connection lost</span>
        <button type="button" class="btn conn-lost__retry" id="conn-retry">Retry</button>
    </div>

    <!-- Recent sources (host, port, user only — never a password). Shown with the form. -->
    <ul class="conn-recent" id="conn-recent" aria-label="Recent connections" hidden></ul>

    <form class="conn-form" id="conn-form" autocomplete="off">
        <!-- One block: a row per field, label left, value right. -->
        <div class="conn-fields">
            <div class="form-field">
                <label for="conn-host">Host</label>
                <input type="text" id="conn-host" name="host" maxlength="253" placeholder="db.example.com" />
            </div>
            <div class="form-field">
                <label for="conn-port">Port</label>
                <input type="text" inputmode="numeric" maxlength="5" id="conn-port" name="port" value="8443" />
            </div>
            <div class="form-field">
                <label for="conn-user">User</label>
                <input type="text" id="conn-user" name="user" maxlength="64" value="default" />
            </div>
            <div class="form-field">
                <label for="conn-password">Password</label>
                <input type="password" id="conn-password" name="password" maxlength="256" />
            </div>
        </div>
        <!-- Secure (TLS) is on by default (D10). Trust is on by default too (D11, internal servers) and only shown under TLS; its note
             appears once the user is about to connect with it on, or has touched the switch (D98). -->
        <div class="conn-options">
            <label class="form-check">
                <input type="checkbox" role="switch" id="conn-secure" name="secure" checked />
                Secure (TLS)
            </label>
            <label class="form-check" id="conn-allowcert-row">
                <input type="checkbox" role="switch" id="conn-allowcert" name="allowInvalidCert" checked />
                Trust self-signed certificate
            </label>
            <p class="form-warn" id="conn-allowcert-warn" hidden>
                The certificate is not checked. Use this only for a server you trust.
            </p>
        </div>
        <p class="form-error" id="conn-error" role="alert" hidden></p>
        <div class="conn-form__actions">
            <button type="submit" class="btn btn--primary" id="conn-connect">Connect</button>
            <button type="button" class="btn" id="conn-cancel" hidden>Cancel</button>
        </div>
    </form>
</section>

@* Connection tile (sidebar top), shown only while connected — the connect form lives on the Data Source start card
   (Connection/_ConnectForm.cshtml, inside Canvas/_Canvas.cshtml). Wired end-to-end in Connection/connection.js. *@
<h2 class="sidebar__title" id="conn-title" hidden>Connection</h2>
<section class="sidebar__section sidebar__section--conn" id="conn-section" aria-labelledby="conn-title" hidden>

    <!-- Connected: one row. Its dot is the only coloured thing here and shows the last liveness probe (ok / checking / lost),
         never the moment of connecting. The two things you can do with a connection sit on the row, right-aligned. -->
    <div class="conn-summary" id="conn-summary" data-health="ok" hidden>
        <div class="conn-row">
            <span class="conn-status" id="conn-status" aria-hidden="true"></span>
            <span class="conn-row__text">
                <span class="conn-summary__host" id="conn-host-label"></span>
                <span class="conn-summary__meta" id="conn-detail-label"></span>
            </span>
            <div class="conn-row__actions">
                <button type="button" class="iconbtn conn-row__btn" id="conn-change" aria-controls="conn-form"
                        aria-label="Change connection" title="Change connection"><span data-icon="edit"></span></button>
                <button type="button" class="iconbtn conn-row__btn" id="conn-disconnect"
                        aria-label="Disconnect" title="Disconnect"><span data-icon="power"></span></button>
            </div>
        </div>
        <span class="sr-only" id="conn-health-text" role="status">Connected</span>
    </div>

    <!-- Shown only when probes fail: what happened, and the one way out. -->
    <div class="conn-lost" id="conn-lost" hidden>
        <span class="conn-lost__text">Connection lost</span>
        <button type="button" class="btn conn-lost__retry" id="conn-retry">Retry</button>
    </div>
</section>

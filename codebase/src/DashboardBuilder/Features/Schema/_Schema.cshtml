@* Database picker + table list (sidebar). Populated in Schema/schema.js, gated until connected. *@
<section class="sidebar__section" hidden id="schema-section" aria-labelledby="db-title">
    <h2 class="sidebar__title" id="db-title">Database</h2>
    <select class="select" id="db-select" aria-label="Database"></select>
</section>

<section class="sidebar__section sidebar__section--grow" hidden id="tables-section" aria-labelledby="tables-title">
    <div class="sidebar__title-row">
        <h2 class="sidebar__title" id="tables-title">Tables</h2>
        <div class="sidebar__title-actions">
            <button type="button" class="btn" id="union-open">Union</button>
            <button type="button" class="btn" id="unpivot-open">Unpivot</button>
        </div>
    </div>
    <label class="table-search">
        <span data-icon="search" aria-hidden="true"></span>
        <input type="search" class="input" id="table-search" placeholder="Search tables" aria-label="Search tables"
               maxlength="100" autocomplete="off" spellcheck="false" />
    </label>
    <p class="table-list__empty" id="table-empty" hidden>No tables match.</p>
    <div class="table-list" id="table-list"></div>
</section>

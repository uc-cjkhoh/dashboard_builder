@* Data Source view: drag tables here → entity cards + relationships (shared canvas). Driven by
   Canvas/canvas.js (entities + empty state) and Relations/relations.js (links). *@
<section class="view view--model" id="model-view" aria-label="Data source">
    <div class="canvas__empty" id="canvas-empty">
        <!-- The start card. While the connect form shows (disconnected, or "Change connection"), it is a card: recent connections on
             the left, the form on the right (both driven by Connection/connection.js). Otherwise the recent panel and the form are
             hidden, the card styling goes with them, and only the canvas empty state (sentence + one action) is left. -->
        <div class="start-card">
            <section class="start-card__side" id="start-recent-panel" aria-labelledby="start-recent-title" hidden>
                <h2 class="start-card__heading" id="start-recent-title">Recent connections</h2>
                <!-- host, port and user only — never a password -->
                <ul class="conn-recent" id="conn-recent" hidden></ul>
                <p class="start-card__none" id="conn-recent-none" hidden>None yet.</p>
            </section>
            <div class="start-card__main">
                <div class="start-card__empty">
                    <svg class="empty__model" viewBox="0 0 320 120" aria-hidden="true" focusable="false">
                        <rect class="empty__card" x="1" y="9" width="112" height="102" rx="8" />
                        <rect class="empty__card" x="207" y="9" width="112" height="102" rx="8" />
                        <path class="empty__row" d="M17 33h56M17 57h72M17 81h48M223 33h64M223 57h40M223 81h72" />
                        <path class="empty__link" d="M113 57h39a8 8 0 0 1 8 8v8a8 8 0 0 0 8 8h39" />
                        <path class="empty__end" d="M125 49v16M207 81l-15-8M207 81h-15M207 81l-15 8" />
                    </svg>
                    <p class="empty__title" id="canvas-empty-title">Connect to a ClickHouse server to begin.</p>
                    <button type="button" class="btn btn--primary" id="canvas-empty-action">Connect</button>
                </div>
                <partial name="~/Features/Connection/_ConnectForm.cshtml" />
            </div>
        </div>
    </div>
</section>
@* Data preview: the first rows of one card, docked under the canvas (Canvas/data-preview.js). Opened from Preview data in a card's ☰ menu
   and after Edit SQL is saved; shown only on the Data Source. A sibling of #model-view, so the ground (pan, zoom, free slots) shrinks
   above it and never runs under it. *@
<section class="ds-preview" id="ds-preview" aria-labelledby="ds-preview-title" hidden>
    <div class="ds-preview__grip" id="ds-preview-grip" role="separator" aria-orientation="horizontal" aria-label="Resize data preview"
         title="Drag to resize" tabindex="0"></div>
    <header class="ds-preview__head">
        <h2 class="ds-preview__title" id="ds-preview-title"></h2>
        <span class="ds-preview__summary" id="ds-preview-summary" role="status"></span>
        <nav class="ds-preview__pager" id="ds-preview-pager" aria-label="Pages of rows" hidden>
            <button type="button" class="iconbtn" id="ds-preview-prev" aria-label="Previous 100 rows" title="Previous 100 rows" disabled><span data-icon="chevron-left"></span></button>
            <label class="ds-preview__page">Page <input class="input ds-preview__page-input" id="ds-preview-page" type="text" inputmode="numeric"
                autocomplete="off" spellcheck="false" value="1" aria-label="Page number" title="Type a page number, then Enter"></label>
            <button type="button" class="iconbtn" id="ds-preview-next" aria-label="Next 100 rows" title="Next 100 rows" disabled><span data-icon="chevron-right"></span></button>
        </nav>
        <button type="button" class="iconbtn" id="ds-preview-refresh" aria-label="Refresh rows" title="Refresh rows"><span data-icon="refresh"></span></button>
        <button type="button" class="iconbtn" id="ds-preview-csv" aria-label="Export CSV" title="Export CSV" disabled><span data-icon="export"></span></button>
        <button type="button" class="iconbtn" id="ds-preview-close" aria-label="Close data preview" title="Close"><span data-icon="close"></span></button>
    </header>
    <div class="ds-preview__notes" id="ds-preview-notes" hidden></div>
    <div class="ds-preview__scroll" id="ds-preview-scroll" tabindex="0" role="region" aria-label="Rows"></div>
</section>

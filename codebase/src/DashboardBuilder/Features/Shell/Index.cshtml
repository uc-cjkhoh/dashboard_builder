@using DashboardBuilder.Features.Shell
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject AssetCatalog Catalog
@{
    Layout = null;
    // Every asset URL carries the content hash of the build (see Program.cs, AssetCaching), so the browser keeps them without revalidating.
    var v = Catalog.Current;
    var assets = Url.Content("~/features/" + v.Prefix);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    @* The zone the UI shows clock times in: Display:TimeZone, else the host machine's, else Malaysia (UTC+8) — Core/timezone.js reads it. *@
    <meta name="app-timezone" content="@AppTimeZone.Resolve(Config["Display:TimeZone"], TimeZoneInfo.Local.Id)" />
    <title>Dashboard Builder</title>
    @* Favicon: the sidebar's four-square brand mark in the accent lime (#a9c43c, --accent). Inline, so it needs no extra request, no static
       mapping and no path prefix — and the browser never asks for /favicon.ico. An SVG cannot read the CSS tokens, so the hex is kept in step by hand. *@
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23a9c43c'%3E%3Crect x='3' y='3' width='8' height='8' rx='1.5'/%3E%3Crect x='13' y='3' width='8' height='8' rx='1.5'/%3E%3Crect x='3' y='13' width='8' height='8' rx='1.5'/%3E%3Crect x='13' y='13' width='8' height='8' rx='1.5'/%3E%3C/svg%3E" />
    @* Sets <html data-scheme> before first paint (Light / Dark — Core/scheme.js), so dark never flashes light. *@
    <script src="@(assets)/Core/scheme-boot.js"></script>
    @* Core first (design tokens + shared components), then per-feature stylesheets. *@
    <link rel="stylesheet" href="@(assets)/Core/core.css" />
    <link rel="stylesheet" href="@(assets)/Shell/shell.css" />
    <link rel="stylesheet" href="@(assets)/Connection/connection.css" />
    <link rel="stylesheet" href="@(assets)/Schema/schema.css" />
    <link rel="stylesheet" href="@(assets)/Canvas/canvas.css" />
    <link rel="stylesheet" href="@(assets)/Core/vendor/codemirror/codemirror-sql.css" /> <!-- structure of the Edit SQL code editor (colours: canvas.css); its script loads when a dialog first opens -->
    <link rel="stylesheet" href="@(assets)/Relations/relations.css" />
    <link rel="stylesheet" href="@(assets)/Tabs/tabs.css" />
    <link rel="stylesheet" href="@(assets)/Dashboard/dashboard.css" />
    <link rel="stylesheet" href="@(assets)/Board/board.css" />
    <link rel="stylesheet" href="@(assets)/Story/story.css" />
    <link rel="stylesheet" href="@(assets)/Workbook/workbook.css" />
    <link rel="stylesheet" href="@(assets)/Calc/calc.css" />
    <link rel="stylesheet" href="@(assets)/Rows/rows.css" />
    <link rel="stylesheet" href="@(assets)/Core/buttons.css" />
    @* The whole module graph is known to the server (Shell/StaticAssets.cs), so the browser fetches every module and the charting library
       in one parallel wave instead of discovering imports six levels deep. *@
    <link rel="preload" as="script" href="@(assets)/Core/vendor/echarts.min.js" />
    @foreach (var module in v.Modules)
    {
        <link rel="modulepreload" href="@(assets)/@module" />
    }
</head>
<body>
    <div class="app" data-connecting>
        <!-- Until the first connection answer: an indeterminate bar (Shell/shell.css); connection.js hides it. -->
        <div class="app-loading" id="app-loading" role="progressbar" aria-label="Connecting"><span class="app-loading__bar"></span></div>
        <!-- Glass chrome: connection + schema browser -->
        <aside class="sidebar glass">
            <div class="sidebar__brand">
                <span class="sidebar__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <rect x="3" y="3" width="8" height="8" rx="1.5" />
                        <rect x="13" y="3" width="8" height="8" rx="1.5" />
                        <rect x="3" y="13" width="8" height="8" rx="1.5" />
                        <rect x="13" y="13" width="8" height="8" rx="1.5" />
                    </svg>
                </span>
                <span class="sidebar__brand-text">
                    <span class="sidebar__brand-name">Dashboard Builder</span>
                </span>
                <!-- Collapse to a narrow rail (Shell/sidebar.js); the choice is remembered in this browser. -->
                <button type="button" class="iconbtn sidebar__toggle" id="sidebar-toggle"
                        aria-controls="sidebar-body" aria-expanded="true"
                        aria-label="Collapse sidebar" title="Collapse sidebar"><span data-icon="sidebar"></span></button>
            </div>

            <div class="sidebar__body" id="sidebar-body">
                <partial name="~/Features/Connection/_Connection.cshtml" />
                <!-- Connection above, Database and Table below: a full-width hairline in a gap that absorbs spare height. Shown once connected. -->
                <div class="sidebar__divider" id="sidebar-divider" role="separator" hidden></div>
                <partial name="~/Features/Schema/_Schema.cshtml" />
                <!-- Worksheet tabs only: Calculated fields, Parameters and Hierarchies (Dashboard/dashboards.js fills it). -->
                <div class="sidebar__tools" id="ws-tools"></div>
                <!-- Recent query and render timings (Shell/perf-panel.js); kept in this tab only. A sidebar tool tile like the worksheet tools, pinned to the bottom; not shown on the Data Source tab. -->
                <button type="button" class="iconbtn sidebar__tool sidebar__perf" id="perf-btn" aria-haspopup="dialog"
                        aria-label="Performance timings" title="Performance timings"><span data-icon="chart-gauge"></span></button>
            </div>

            <!-- Drag to resize the sidebar (up to 30% of the screen). -->
            <div class="resizer sidebar__resizer" id="sidebar-resizer" role="separator"
                 aria-orientation="vertical" aria-label="Resize sidebar" tabindex="0"></div>
        </aside>

        <!-- Workspace: entity cards, relationships, subtabs -->
        <main class="canvas" id="canvas">
            <div class="canvas__bar glass">
                <h1 class="sr-only">Data source, worksheets, dashboards and stories</h1>
                <div class="tabs" id="tabs" role="tablist" aria-label="Data source, worksheets, dashboards and stories"></div>
                <partial name="~/Features/Workbook/_Workbook.cshtml" />
                <!-- Appearance (Shell/appearance.js): one card for mode (Light / Dark, kept in this browser), dark look, accent and chart colours (saved with the workbook). -->
                <div class="menu scheme">
                    <button type="button" class="iconbtn" id="scheme-btn" aria-controls="scheme-list"
                            aria-label="Appearance" title="Appearance"><span data-icon="sun"></span></button>
                    <div class="menu__list" id="scheme-list" role="menu" aria-label="Appearance" hidden></div>
                </div>
            </div>

            <partial name="~/Features/Canvas/_Canvas.cshtml" />
            <partial name="~/Features/Dashboard/_Dashboard.cshtml" />
            <partial name="~/Features/Board/_Board.cshtml" />
            <partial name="~/Features/Story/_Story.cshtml" />
        </main>
    </div>

    <div class="sr-only" id="toast-live" role="status" aria-live="polite"></div>
    <div class="toast" id="toast" hidden></div>
    <!-- What the app is waiting on (Shell/activity-bar.js): shown while an API request is in flight. -->
    <div class="activity" id="activity" role="status" aria-live="polite" hidden>
        <span class="activity__glyph" id="activity-glyph" aria-hidden="true"></span>
        <span class="activity__text" id="activity-text"></span>
    </div>

    <!-- Self-hosted charting library (no CDN). Classic script runs before the deferred module
         graph, so `window.echarts` is ready when Dashboard/chart.js first renders. -->
    <script src="@(assets)/Core/vendor/echarts.min.js"></script>
    <script type="module" src="@(assets)/Shell/app.js"></script>
</body>
</html>

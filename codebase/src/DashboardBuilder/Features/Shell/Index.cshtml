@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Dashboard Builder</title>
    @* Sets <html data-scheme> before first paint (System / Light / Dark — Core/scheme.js), so dark never flashes light. *@
    <script src="~/features/Core/scheme-boot.js"></script>
    @* Core first (design tokens + shared components), then per-feature stylesheets. *@
    <link rel="stylesheet" href="~/features/Core/core.css" />
    <link rel="stylesheet" href="~/features/Shell/shell.css" />
    <link rel="stylesheet" href="~/features/Connection/connection.css" />
    <link rel="stylesheet" href="~/features/Schema/schema.css" />
    <link rel="stylesheet" href="~/features/Canvas/canvas.css" />
    <link rel="stylesheet" href="~/features/Relations/relations.css" />
    <link rel="stylesheet" href="~/features/Tabs/tabs.css" />
    <link rel="stylesheet" href="~/features/Dashboard/dashboard.css" />
    <link rel="stylesheet" href="~/features/Board/board.css" />
    <link rel="stylesheet" href="~/features/Story/story.css" />
    <link rel="stylesheet" href="~/features/Workbook/workbook.css" />
    <link rel="stylesheet" href="~/features/Calc/calc.css" />
    <link rel="stylesheet" href="~/features/Rows/rows.css" />
    <link rel="stylesheet" href="~/features/Core/buttons.css" />
</head>
<body>
    <div class="app">
        <!-- Glass chrome: connection + schema browser -->
        <aside class="sidebar glass">
            <div class="sidebar__brand">
                <span class="sidebar__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <rect x="3" y="3" width="8" height="8" rx="1.5" />
                        <rect x="13" y="3" width="8" height="8" rx="1.5" />
                        <rect x="3" y="13" width="8" height="8" rx="1.5" />
                        <rect x="13" y="13" width="8" height="8" rx="1.5" />
                    </svg>
                </span>
                <span class="sidebar__brand-text">
                    <span class="sidebar__brand-name">Dashboard Builder</span>
                </span>
                <!-- Collapse to a narrow rail (Shell/sidebar.js); the choice is remembered in this browser. -->
                <button type="button" class="iconbtn sidebar__toggle" id="sidebar-toggle"
                        aria-controls="sidebar-body" aria-expanded="true"
                        aria-label="Collapse sidebar" title="Collapse sidebar"><span data-icon="sidebar"></span></button>
            </div>

            <div class="sidebar__body" id="sidebar-body">
                <partial name="~/Features/Connection/_Connection.cshtml" />
                <partial name="~/Features/Schema/_Schema.cshtml" />
                <!-- Worksheet tabs only: Calculated fields and Hierarchies (Dashboard/dashboards.js fills it). -->
                <div class="sidebar__tools" id="ws-tools"></div>
            </div>

            <!-- Drag to resize the sidebar (up to 30% of the screen). -->
            <div class="resizer sidebar__resizer" id="sidebar-resizer" role="separator"
                 aria-orientation="vertical" aria-label="Resize sidebar" tabindex="0"></div>
        </aside>

        <!-- Workspace: entity cards, relationships, subtabs -->
        <main class="canvas" id="canvas">
            <div class="canvas__bar glass">
                <h1 class="sr-only">Data source, worksheets, dashboards and stories</h1>
                <div class="tabs" id="tabs" role="tablist" aria-label="Data source, worksheets, dashboards and stories"></div>
                <partial name="~/Features/Workbook/_Workbook.cshtml" />
                <!-- Recent query and render timings (Shell/perf-panel.js); kept in this tab only. -->
                <button type="button" class="iconbtn" id="perf-btn" aria-haspopup="dialog"
                        aria-label="Performance timings" title="Performance timings"><span data-icon="chart-gauge"></span></button>
                <!-- Light / dark toggle (Shell/scheme-toggle.js): System / Light / Dark, remembered in this browser. -->
                <div class="menu scheme">
                    <button type="button" class="iconbtn" id="scheme-btn" aria-controls="scheme-list"
                            aria-label="Appearance" title="Appearance"><span data-icon="monitor"></span></button>
                    <div class="menu__list" id="scheme-list" role="menu" aria-label="Appearance" hidden></div>
                </div>
            </div>

            <partial name="~/Features/Canvas/_Canvas.cshtml" />
            <partial name="~/Features/Dashboard/_Dashboard.cshtml" />
            <partial name="~/Features/Board/_Board.cshtml" />
            <partial name="~/Features/Story/_Story.cshtml" />
        </main>
    </div>

    <div class="sr-only" id="toast-live" role="status" aria-live="polite"></div>
    <div class="toast" id="toast" hidden></div>

    <!-- Self-hosted charting library (no CDN). Classic script runs before the deferred module
         graph, so `window.echarts` is ready when Dashboard/chart.js first renders. -->
    <script src="~/features/Core/vendor/echarts.min.js"></script>
    <script type="module" src="~/features/Shell/app.js"></script>
</body>
</html>

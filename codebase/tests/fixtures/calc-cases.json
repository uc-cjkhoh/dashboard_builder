    {"name":"nested aggregate","formula":"SUM(AVG([orders.amount]))","ast":{"k":"agg","fn":"sum","arg":{"k":"agg","fn":"avg","arg":{"k":"field","db":"shop","table":"orders","column":"amount"}}},"expect":{"error":"An aggregate can't contain another aggregate.","path":"arg"}},

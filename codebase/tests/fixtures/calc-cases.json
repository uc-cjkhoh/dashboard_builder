    {"name":"MAX refuses a boolean (multi-type wording)","formula":"MAX([orders.active])","ast":{"k":"agg","fn":"max","arg":{"k":"field","db":"shop","table":"orders","column":"active"}},"expect":{"error":"MAX needs a number, date or text — orders.active is boolean.","path":"arg"}},
    {"name":"count of a boolean","formula":"COUNT([orders.active])","ast":{"k":"agg","fn":"count","arg":{"k":"field","db":"shop","table":"orders","column":"active"}},"expect":{"type":"number","isAggregate":true,"tables":["shop.orders"]}},
    {"name":"operand that is not a field is named that value","formula":"MAX([orders.status]) + 1","ast":{"k":"bin","op":"+","l":{"k":"agg","fn":"max","arg":{"k":"field","db":"shop","table":"orders","column":"status"}},"r":{"k":"num","v":1}},"expect":{"error":"Arithmetic needs numbers — that value is text.","path":"l"}},
    {"name":"arithmetic refuses a boolean","formula":"[orders.active] + 1","ast":{"k":"bin","op":"+","l":{"k":"field","db":"shop","table":"orders","column":"active"},"r":{"k":"num","v":1}},"expect":{"error":"Arithmetic needs numbers — orders.active is boolean.","path":"l"}},
    {"name":"both operands are typed before either is checked","formula":"[orders.status] + [orders.nope]","ast":{"k":"bin","op":"+","l":{"k":"field","db":"shop","table":"orders","column":"status"},"r":{"k":"field","db":"shop","table":"orders","column":"nope"}},"expect":{"error":"Unknown field orders.nope.","path":"r"}},
